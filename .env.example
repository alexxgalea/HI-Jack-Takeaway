# Copy to .env and fill in real values. Never commit .env.

# The default alembic and uvicorn pick up. Not pytest: since M7 the suite
# injects the throwaway database from docker-compose.test.yml (port 55432) and
# refuses to run against any database that is not a test one, so no value in
# this file can aim the suite at data you care about. See tests/conftest.py
# and the Tests section of README.md.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hijack_takeaway

# The dev database is an explicit override, never the default. Seed it and
# run the server against it when you want data that survives between runs:
#
#   export DEV_DB=postgresql+psycopg://postgres:postgres@localhost:5432/hijack_takeaway_dev
#   DATABASE_URL=$DEV_DB alembic upgrade head
#   DATABASE_URL=$DEV_DB python -c "from app.db.session import SessionLocal; from app.db.seed import seed; seed(SessionLocal())"
#   DATABASE_URL=$DEV_DB uvicorn app.main:app --reload
#
# Pointing DATABASE_URL at the dev database and then running pytest used to be
# the one combination to avoid - seed() writes admin@example.com, the same
# address the admin test fixture inserts. Since M7 the suite refuses that URL
# outright instead of colliding with it.

# Generate a fresh secret per environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start if this is unset.
JWT_SECRET=your-secret-key-here-generate-per-environment

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call the API, as a JSON list. Defaults to ["*"]
# with credentials disabled, which is safe only because auth is a Bearer header
# and never a cookie. Narrow it per deployment:
# CORS_ORIGINS=["https://app.example.com"]
