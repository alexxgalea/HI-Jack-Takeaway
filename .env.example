# Copy to .env and fill in real values. Never commit .env.

# Two databases, deliberately separate until M7 replaces this with
# docker-compose.test.yml. This one is the default every command picks up,
# and pytest owns it: the suite creates and rolls back its own fixtures, so
# anything seeded here collides with them.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hijack_takeaway

# The dev database is an explicit override, never the default. Seed it and
# run the server against it when you want data that survives between runs:
#
#   export DEV_DB=postgresql+psycopg://postgres:postgres@localhost:5432/hijack_takeaway_dev
#   DATABASE_URL=$DEV_DB alembic upgrade head
#   DATABASE_URL=$DEV_DB python -c "from app.db.session import SessionLocal; from app.db.seed import seed; seed(SessionLocal())"
#   DATABASE_URL=$DEV_DB uvicorn app.main:app --reload
#
# Pointing DATABASE_URL at the dev database and then running pytest is the
# one combination to avoid: seed() writes admin@example.com, which is the
# same address the admin test fixture inserts.

# Generate a fresh secret per environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start if this is unset.
JWT_SECRET=your-secret-key-here-generate-per-environment

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
